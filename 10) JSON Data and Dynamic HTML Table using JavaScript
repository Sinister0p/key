<!DOCTYPE html>
<html>
<body>
<h2>Student Details</h2>
<table border="1" id="studentTable">
<tr><th>Roll No</th><th>Name</th><th>Course</th><th>Marks</th></tr>
</table>
<script>
const students = [
 {rollNo:1, name:"Rahul", course:"BSc IT", marks:85},
 {rollNo:2, name:"Priya", course:"BSc IT", marks:78},
 {rollNo:3, name:"Amit", course:"BCA", marks:92},
 {rollNo:4, name:"Sneha", course:"BCA", marks:75}
];
const table = document.getElementById("studentTable");
students.forEach(function(student) {
 const row = table.insertRow();
 row.insertCell(0).innerHTML = student.rollNo;
 row.insertCell(1).innerHTML = student.name;
 row.insertCell(2).innerHTML = student.course;
 row.insertCell(3).innerHTML = student.marks;
});
</script>
</body>
</html>
