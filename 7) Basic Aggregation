db.Students.aggregate([
 {$match:{course:"BSc IT"}}
])
db.Students.aggregate([
 {$group:{_id:"$course"}}
])
db.Students.aggregate([
 {$group:{
 _id:"$course",
 totalStudents:{$sum:1}
 }}
])
db.Students.aggregate([
 {$group:{
 _id:"$course",
 averageMarks:{$avg:"$marks"}
 }}
])
db.Students.aggregate([
 {$match:{marks:{$gt:50}}},
 {$group:{
 _id:"$course",
 averageMarks:{$avg:"$marks"}
 }}
])
